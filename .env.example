DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Contrasena del panel admin (obligatorio en produccion; en dev se puede omitir para acceso libre)
ADMIN_PASSWORD=""

# URL publica de la app (links en emails, OG tags, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (notificaciones por email)
RESEND_API_KEY=""
EMAIL_FROM="JF Studio <hola@jfstudio.local>"

# Cron de recordatorios y de respaldo (protege /api/cron/reminders y /api/cron/backup)
CRON_SECRET=""

# Correo directo de la duena (nueva reserva con comprobante; tambien recibe el AVISO
# de estado del respaldo diario — sin datos de clientas, nunca el archivo adjunto)
ADMIN_EMAIL=""

# Comprobantes de adelanto web Y respaldos diarios (S3-compatible: AWS S3, Cloudflare R2, MinIO…)
# OBLIGATORIO para que el respaldo automatico se guarde: sin esto, el cron no tiene donde
# subir el archivo (ya NO se envia por correo, para no exponer datos de clientas sin cifrar).
# Los respaldos se guardan en el mismo bucket bajo el prefijo backups/<año>/, cifrados (SSE-AES256).
DEPOSIT_S3_BUCKET=""
DEPOSIT_S3_REGION="auto"
DEPOSIT_S3_ACCESS_KEY_ID=""
DEPOSIT_S3_SECRET_ACCESS_KEY=""
# Opcional: endpoint custom (R2 / MinIO), ej. https://<accountid>.r2.cloudflarestorage.com
DEPOSIT_S3_ENDPOINT=""
